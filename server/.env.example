# ==========================================
# Server Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
# Local MongoDB example:
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect
# MongoDB Atlas example (uncomment and fill in):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/campusconnect?retryWrites=true&w=majority

# JWT Authentication
# Generate a strong random secret, e.g. with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
